<resources>
    <!-- Expressive floating dock (bottom navigation) -->
    <dimen name="glimpse_dock_height">72dp</dimen>
    <dimen name="glimpse_dock_elevation">3dp</dimen>
    <dimen name="glimpse_dock_margin_horizontal">24dp</dimen>
    <dimen name="glimpse_dock_margin_bottom">16dp</dimen>
    <!-- Space content should reserve above the dock so its last row rests
         just clear of it (dock_margin_bottom + dock_height + a small gap) -->
    <dimen name="glimpse_dock_content_reserved_space">100dp</dimen>
    <!-- Settings button, docked side by side with the floating dock -->
    <dimen name="glimpse_dock_settings_size">72dp</dimen>
    <dimen name="glimpse_dock_settings_gap">8dp</dimen>
    <dimen name="glimpse_dock_settings_corner_radius">22dp</dimen>
    <dimen name="glimpse_dock_corner_radius">50dp</dimen>
</resources>
