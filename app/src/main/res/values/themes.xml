<resources>
    <!-- Base application theme -->
    <style name="Theme.Glimpse" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="bottomNavigationStyle">@style/Widget.Glimpse.NavigationBarView.Dock</item>
    </style>

    <!-- Top app bar option -->
    <style name="Theme.Glimpse.TopAppBarOption">
        <item name="android:iconTint">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!-- Bottom app bar option -->
    <style name="Theme.Glimpse.BottomAppBarOption">
        <item name="android:iconTint">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!-- Expressive floating dock (bottom navigation) -->
    <style name="Widget.Glimpse.NavigationBarView.Dock" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">@dimen/glimpse_dock_height</item>
        <item name="elevation">@dimen/glimpse_dock_elevation</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">10dp</item>
        <item name="itemIconGravity">top</item>
        <item name="itemGravity">center</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="labelFontScalingEnabled">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Glimpse.Dock</item>
    </style>

    <!-- Fully-rounded pill shape used by the dock -->
    <style name="ShapeAppearance.Glimpse.Dock" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Settings button docked side by side with the floating dock -->
    <style name="Widget.Glimpse.Button.Dock.Settings" parent="Widget.Material3Expressive.Button.IconButton.Filled">
        <item name="shapeAppearance">@style/ShapeAppearance.Glimpse.Dock.Settings</item>
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
        <item name="iconTint">?attr/colorOnTertiaryContainer</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Rounded square (squircle) shape used by the docked settings button -->
    <style name="ShapeAppearance.Glimpse.Dock.Settings" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/glimpse_dock_settings_corner_radius</item>
    </style>

    <!-- Media viewer -->
    <style name="Theme.Glimpse.MediaViewer" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <!-- Media viewer bottom sheet -->
    <style name="Theme.Glimpse.MediaViewer.BottomSheet" />

    <!-- Media viewer bottom sheet buttons -->
    <style name="Theme.Glimpse.MediaViewer.BottomSheet.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawableTint">@android:color/white</item>
        <item name="android:hyphenationFrequency">normal</item>
        <item name="android:maxLines">3</item>
        <item name="android:maxWidth">320dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceCaption</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <!-- Media info bottom sheet dialog -->
    <style name="Theme.Glimpse.MediaInfoBottomSheetDialog" />

    <!-- Media info bottom sheet dialog date/time text -->
    <style name="Theme.Glimpse.MediaInfoBottomSheetDialog.DateTimeText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="android:textSize">16sp</item>
        <item name="android:typeface">monospace</item>
    </style>

    <!-- Media info bottom sheet dialog list item -->
    <style name="Theme.Glimpse.MediaInfoBottomSheetDialog.ListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Set wallpaper dialog theme -->
    <style name="Theme.Glimpse.SetWallpaperDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog.Centered">
        <item name="listItemLayout">@layout/set_wallpaper_dialog_item</item>
    </style>
</resources>
